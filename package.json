{
  "name": "clinic-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tz:utc": "cross-env TZ=UTC vitest run",
    "test:tz:la": "cross-env TZ=America/Los_Angeles vitest run",
    "test:tz:kolkata": "cross-env TZ=Asia/Kolkata vitest run",
    "test:all-zones": "npm run test:tz:utc && npm run test:tz:la && npm run test:tz:kolkata",
    "scan:emojis": "tsx scripts/scan-emojis.ts",
    "scan:commits": "tsx scripts/scan-commits.ts",
    "verify": "npm run build && npm run typecheck && npm run test:all-zones && npm run scan:emojis && npm run scan:commits && npm run scan:colors",
    "scan:colors": "tsx scripts/scan-colors.ts",
    "db:check": "node scripts/check-supabase.js",
    "db:seed": "tsx scripts/seed-supabase.ts",
    "db:seed:minimal": "node scripts/seed-minimal.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vitest": "^5.0.5"
  }
}
